---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" canonicalPath="/404.html">
  <section class="page-hero not-found">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>That page isn’t here.</h1>
      <p>The talk may have moved, or the address may be incomplete.</p>
      <a class="button" href="/">Return to the seminar schedule</a>
    </div>
  </section>
</BaseLayout>
